# Локальный .env для docker-compose.yml (запуск на своей машине).
# У всех значений есть дефолты в compose — файл нужен только чтобы что-то
# переопределить (например, порты, если 8088/8001/5433 заняты).
# Прод-конфиг НЕ здесь — он в GitHub-секрете PRODUCTION_ENV_FILE (см. DEPLOYMENT.md).

# Локальная БД в контейнере
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_pass
POSTGRES_DB=appdb

# Порты на хосте
WEB_PORT=8088
API_PORT=8001
PG_PORT=5433

# Dev-секрет единого входа (локально должен совпадать с прайсом — тот же дефолт)
AUTH_TOKEN_SECRET=dev-secret-change-me
FIRST_ADMIN_PASS=dev-first-admin-pass
CORS_ALLOW_ORIGINS=*
